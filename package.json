{
  "name": "hybrid-automation-e2e",
  "version": "1.0.0",
  "description": "Playwright API and UI layered automation framework aligned to strict TypeScript and hybrid patterns.",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "clean:allure-results": "node -e \"require('node:fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run clean:allure-results && playwright test",
    "test:api": "npm run clean:allure-results && playwright test --project=api",
    "test:ui": "npm run clean:allure-results && playwright test --project=ui",
    "test:smoke": "npm run clean:allure-results && playwright test --grep @smoke",
    "test:headed": "npm run clean:allure-results && playwright test --headed",
    "test:ui-headed": "npm run clean:allure-results && playwright test --project=ui --headed",
    "report:html": "playwright show-report",
    "report:allure": "npm run report:allure:generate && allure open allure-report",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation"
  ],
  "license": "ISC",
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": "eslint"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.29.1"
  }
}
