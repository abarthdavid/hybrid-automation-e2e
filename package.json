{
  "name": "hybrid-automation-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E framework aligned to strict TypeScript and hybrid automation patterns.",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report:html": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation"
  ],
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.29.1"
  }
}
